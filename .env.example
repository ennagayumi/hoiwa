# Canonical origin used for <link rel="canonical">, Open Graph URLs, sitemap.xml and robots.txt.
# Defaults to https://hoiwajapan.com when unset; override for preview deployments.
NEXT_PUBLIC_SITE_URL=https://hoiwajapan.com

# Optional: Google Search Console "HTML tag" verification token (content attribute only).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Resend (contact form). Never expose this key in client code.
# Verify hoiwajapan.com in the Resend dashboard so FROM can use this domain.
RESEND_API_KEY=
CONTACT_TO_EMAIL=takeda@hoiwajapan.com
CONTACT_FROM_EMAIL=Hoiwa Website <takeda@hoiwajapan.com>
